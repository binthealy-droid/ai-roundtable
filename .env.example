# كل هذي تنحط في Vercel → Settings → Environment Variables (مو في GitHub)

# كلمة سر الموقع (اختر وحدة طويلة)
APP_PASSWORD=

# مفاتيح النماذج
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MANUS_API_KEY=

# اختياري: أسماء النماذج (لو ما حطيتها يستخدم الافتراضي)
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-flash-latest
# اختياري لنماذج التفكير في OpenAI عشان ما يتأخر: low | medium | high
OPENAI_REASONING_EFFORT=
# اختياري لـ Manus: standard | lite | max
MANUS_PROFILE=standard

# رابط موقع GitHub Pages لو تستخدمه (بدون / في الآخر). لو تركته فاضي يقبل أي موقع.
ALLOWED_ORIGIN=https://USERNAME.github.io

# قاعدة البيانات: تنضاف تلقائياً لما تربط Neon من تبويب Storage في Vercel
DATABASE_URL=
